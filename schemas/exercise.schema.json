{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exercise.schema.json",
  "title": "Exercise",
  "description": "Every exercise ships its accepted answers so the app grades offline.",
  "type": "object",
  "required": ["id", "lang", "type", "skill", "level", "prompt", "answers"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "lang": { "$ref": "common.schema.json#/$defs/lang" },
    "type": { "enum": ["recognize", "listen-choose", "fill-blank", "reorder", "translate", "dictation", "comprehension", "read-aloud", "context-choice", "stroke-order"] },
    "skill": { "enum": ["alphabet", "pronunciation", "strokes", "vocabulary", "grammar", "sentence", "listening", "reading", "speaking", "writing", "conversation", "reallife"] },
    "level": { "$ref": "common.schema.json#/$defs/level" },
    "prompt": { "type": "string", "minLength": 1 },
    "choices": { "type": "array", "items": { "type": "string" } },
    "answers": {
      "description": "Accepted answers, compared after normalization (case, punctuation, whitespace, NFC).",
      "type": "array", "minItems": 1, "items": { "type": "string" }
    },
    "explanationVi": { "type": "string" },
    "itemIds": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } }
  }
}
