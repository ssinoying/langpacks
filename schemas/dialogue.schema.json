{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dialogue.schema.json",
  "title": "Dialogue",
  "description": "Branching scripted conversation. Each node is a line; options lead to other nodes.",
  "type": "object",
  "required": ["id", "lang", "level", "title", "start", "nodes"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "lang": { "$ref": "common.schema.json#/$defs/lang" },
    "level": { "$ref": "common.schema.json#/$defs/level" },
    "title": { "type": "string" },
    "start": { "type": "string" },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["speaker", "text"],
        "additionalProperties": false,
        "properties": {
          "speaker": { "type": "string" },
          "text": { "type": "string" },
          "translationVi": { "type": "string" },
          "options": {
            "description": "Learner replies. Empty or missing = end of dialogue.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["answers", "next"],
              "additionalProperties": false,
              "properties": {
                "answers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "next": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
