    "title": "Mặc cả ở cửa hàng",
    "start": "a",
    "nodes": {
      "a": {
        "speaker": "老板",
        "text": "你好，你想买什么？",
        "translationVi": "Chào bạn, bạn muốn mua gì?",
        "options": [
          {
            "answers": [
              "我想买衣服。",
              "买衣服。"
            ],
            "next": "b"
          },
          {
            "answers": [
              "我想买杯子。",
              "买杯子。"
            ],
            "next": "c"
