      },
      "d": {
        "speaker": "老板",
        "text": "好吧，八十块。",
        "translationVi": "Thôi được, tám mươi tệ.",
        "options": [
          {
            "answers": [
              "好，我买了。",
              "我买。",
              "谢谢！"
            ],
            "next": "end"
          }
        ]
