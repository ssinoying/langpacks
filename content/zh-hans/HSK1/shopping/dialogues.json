      },
      "c": {
        "speaker": "老板",
        "text": "这个杯子五块钱。",
        "translationVi": "Cái cốc này năm tệ.",
        "options": [
          {
            "answers": [
              "好，我买一个。",
              "我买一个。",
              "我买。"
            ],
            "next": "end"
          }
