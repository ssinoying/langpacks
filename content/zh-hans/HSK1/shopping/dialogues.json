      },
      "b": {
        "speaker": "老板",
        "text": "这件衣服很好看，一百块。",
        "translationVi": "Cái áo này rất đẹp, một trăm tệ.",
        "options": [
          {
            "answers": [
              "太贵了！便宜一点儿吧。",
              "太贵了！"
            ],
            "next": "d"
          },
