[
  {
    "id": "zh-hans:sentence:500551a2d444aa40",
    "lang": "zh-hans",
    "kind": "sentence",
    "text": "你住在哪儿？",
    "meaningVi": "Bạn sống ở đâu?",
    "level": "HSK1",
    "topics": [
      "home"
    ]
  },
  {
    "id": "zh-hans:sentence:0d7f7caa07c8d351",
    "lang": "zh-hans",
    "kind": "sentence",
    "text": "我住在河内。",
    "meaningVi": "Tôi sống ở Hà Nội.",
    "level": "HSK1",
    "topics": [
      "home"
    ]
  },
  {
    "id": "zh-hans:sentence:377bffb65a94a12c",
    "lang": "zh-hans",
    "kind": "sentence",
    "text": "我家的房子不大。",
    "meaningVi": "Nhà tôi không lớn.",
    "level": "HSK1",
    "topics": [
      "home"
    ]
  },
  {
    "id": "zh-hans:sentence:a63fc96fab252d62",
    "lang": "zh-hans",
    "kind": "sentence",
    "text": "我的房间里有一张床和一张桌子。",
    "meaningVi": "Trong phòng tôi có một cái giường và một cái bàn.",
    "level": "HSK1",
    "topics": [
      "home"
    ]
  },
  {
    "id": "zh-hans:sentence:5027d6178f121ce2",
    "lang": "zh-hans",
    "kind": "sentence",
    "text": "电脑在桌子上。",
    "meaningVi": "Máy tính ở trên bàn.",
    "level": "HSK1",
    "topics": [
      "home"
    ]
  },
  {
    "id": "zh-hans:sentence:ca8608c50df7a280",
    "lang": "zh-hans",
    "kind": "sentence",
    "text": "洗手间在哪儿？",
    "meaningVi": "Nhà vệ sinh ở đâu?",
    "level": "HSK1",
    "topics": [
      "home"
    ]
  },
  {
    "id": "zh-hans:sentence:ad2754d6cdc41f3e",
    "lang": "zh-hans",
    "kind": "sentence",
    "text": "洗手间在我房间旁边。",
    "meaningVi": "Nhà vệ sinh ở cạnh phòng tôi.",
    "level": "HSK1",
    "topics": [
      "home"
    ]
  },
  {
    "id": "zh-hans:sentence:20e8a723daa1dfc9",
    "lang": "zh-hans",
    "kind": "sentence",
    "text": "家里有电视吗？",
    "meaningVi": "Trong nhà có tivi không?",
    "level": "HSK1",
    "topics": [
      "home"
    ]
  },
  {
    "id": "zh-hans:sentence:fab5e30cab037bef",
    "lang": "zh-hans",
    "kind": "sentence",
    "text": "我奶奶住在楼上。",
    "meaningVi": "Bà tôi sống ở tầng trên.",
    "level": "HSK1",
    "topics": [
      "home"
    ]
  },
  {
    "id": "zh-hans:grammar:94636b706ef53616",
    "lang": "zh-hans",
    "kind": "grammar",
    "text": "在 + nơi chốn + từ chỉ vị trí",
    "explanationVi": "\"Ở trên bàn\" là 在桌子上: từ chỉ vị trí 上, 里, 旁边 đứng SAU danh từ, ngược tiếng Việt. Lỗi hay gặp: nói *在上桌子.",
    "level": "HSK1",
    "topics": [
      "home"
    ]
  },
  {
    "id": "zh-hans:grammar:06f7769832b39825",
    "lang": "zh-hans",
    "kind": "grammar",
    "text": "Nơi chốn + 有 + vật: ở đâu có gì",
    "explanationVi": "Câu tồn tại đặt nơi chốn lên đầu: 我的房间里有一张床 = Trong phòng tôi có một cái giường. Giống tiếng Việt \"Trong phòng có…\", nhưng 里 (trong) đứng sau danh từ. Giường, bàn dùng lượng từ 张.",
    "level": "HSK1",
    "topics": [
      "home"
    ]
  },
  {
    "id": "zh-hans:slang:6b7d715cc950b6a1",
    "lang": "zh-hans",
    "kind": "slang",
    "text": "宅",
    "meaningVi": "Ở lì trong nhà.",
    "explanationVi": "宅 (zhái, Hán Việt: trạch) chỉ người thích ở nhà, ít ra ngoài: 我很宅, 宅男, 宅女. Nói vui với bạn bè, đôi khi hơi chê.",
    "register": "slang",
    "status": "current",
    "level": "HSK1",
    "topics": [
      "home"
    ]
  }
