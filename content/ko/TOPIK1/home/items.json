      "home"
    ]
  },
  {
    "id": "ko:sentence:6da838e662c01940",
    "lang": "ko",
    "kind": "sentence",
    "text": "제 방은 작지만 깨끗해요.",
    "meaningVi": "Phòng tôi nhỏ nhưng sạch.",
    "level": "TOPIK1",
    "topics": [
      "home"
    ]
  },
  {
    "id": "ko:sentence:c40afbb946729312",
    "lang": "ko",
