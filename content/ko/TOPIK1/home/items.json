    "topics": [
      "home"
    ]
  },
  {
    "id": "ko:sentence:7b80248c1c1245ce",
    "lang": "ko",
    "kind": "sentence",
    "text": "부엌이 넓어서 좋아요.",
    "meaningVi": "Bếp rộng nên tôi thích.",
    "level": "TOPIK1",
    "topics": [
      "home"
    ]
  },
  {
    "id": "ko:sentence:9c44cb39437aae2c",
