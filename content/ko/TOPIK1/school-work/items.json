    ]
  },
  {
    "id": "ko:sentence:dd8c28c43dd046af",
    "lang": "ko",
    "kind": "sentence",
    "text": "형은 회사에서 일해요.",
    "meaningVi": "Anh trai tôi làm việc ở công ty.",
    "level": "TOPIK1",
    "topics": [
      "school-work"
    ]
  },
  {
    "id": "ko:sentence:de2050887c1ad43c",
    "lang": "ko",
