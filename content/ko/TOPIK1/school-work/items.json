    "level": "TOPIK1",
    "topics": [
      "school-work"
    ]
  },
  {
    "id": "ko:sentence:1b167138662ad8c7",
    "lang": "ko",
    "kind": "sentence",
    "text": "요즘 한국어를 배우고 있어요.",
    "meaningVi": "Dạo này tôi đang học tiếng Hàn.",
