        "text": "我不太會打球，你教我吧！",
        "translationVi": "Mình không giỏi chơi bóng lắm, bạn dạy mình nhé!",
        "options": [
          {
            "answers": [
              "沒問題！",
              "好啊！"
            ],
            "next": "end"
          }
        ]
      },
      "end": {
