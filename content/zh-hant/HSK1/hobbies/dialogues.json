      },
      "b": {
        "speaker": "小雨",
        "text": "好啊，星期六晚上一起去吧！",
        "translationVi": "Được đó, tối thứ Bảy cùng đi nhé!",
        "options": [
          {
            "answers": [
              "好，星期六見！",
              "好！"
            ],
            "next": "end"
