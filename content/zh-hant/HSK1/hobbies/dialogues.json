    "title": "Rủ đi chơi cuối tuần",
    "start": "a",
    "nodes": {
      "a": {
        "speaker": "小雨",
        "text": "週末你想做什麼？",
        "translationVi": "Cuối tuần bạn muốn làm gì?",
        "options": [
          {
            "answers": [
              "我想看電影。",
              "看電影。"
            ],
            "next": "b"
          },
          {
            "answers": [
              "我想去打球。",
              "打球。"
            ],
            "next": "c"
