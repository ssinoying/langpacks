    "explanationVi": "追劇 = theo dõi phim bộ từng tập, thường thức khuya để xem. Dùng thân mật.",
    "register": "slang",
    "status": "current",
    "level": "HSK1",
    "topics": [
      "hobbies"
    ]
  },
  {
