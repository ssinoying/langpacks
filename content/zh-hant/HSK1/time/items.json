    ]
  },
  {
    "id": "zh-hant:sentence:deff87a331c7bb02",
    "lang": "zh-hant",
    "kind": "sentence",
    "text": "你的生日是幾月幾號？",
    "meaningVi": "Sinh nhật bạn là ngày mấy tháng mấy?",
    "level": "HSK1",
    "topics": [
      "time"
    ]
  },
  {
    "id": "zh-hant:sentence:a854288c1db7595a",
    "lang": "zh-hant",
    "kind": "sentence",
    "text": "我早上六點起床。",
    "meaningVi": "Tôi thức dậy lúc sáu giờ sáng.",
    "level": "HSK1",
    "topics": [
      "time"
    ]
  },
  {
    "id": "zh-hant:sentence:7870383957765d74",
    "lang": "zh-hant",
    "kind": "sentence",
    "text": "昨天晚上你做什麼了？",
    "meaningVi": "Tối hôm qua bạn đã làm gì?",
    "level": "HSK1",
    "topics": [
      "time"
    ]
  },
  {
    "id": "zh-hant:sentence:c8447d383b8ed1be",
    "lang": "zh-hant",
    "kind": "sentence",
    "text": "我五月十號去北京。",
    "meaningVi": "Ngày 10 tháng 5 tôi đi Bắc Kinh.",
    "level": "HSK1",
    "topics": [
      "time"
    ]
  },
  {
    "id": "zh-hant:grammar:bd90bb7c8e9b97b7",
    "lang": "zh-hant",
    "kind": "grammar",
    "text": "Thời gian đứng trước động từ",
    "explanationVi": "Tiếng Việt hay nói \"Tôi dậy lúc sáu giờ sáng\", thời gian ở cuối. Tiếng Trung đặt thời gian trước động từ và từ lớn đến nhỏ: 我早上六點起床 (sáng → sáu giờ → dậy). Ngày tháng cũng vậy: 五月十號 = tháng 5 ngày 10.",
    "level": "HSK1",
    "topics": [
      "time"
    ]
  },
  {
    "id": "zh-hant:grammar:eb7204ea10d57486",
    "lang": "zh-hant",
    "kind": "grammar",
    "text": "Thứ trong tuần: 星期 + số",
    "explanationVi": "星期 (tinh kỳ) + số, nhưng lệch một so với tiếng Việt: 星期一 = thứ Hai, 星期三 = thứ Tư, 星期天 = Chủ nhật. Hỏi thứ: 星期幾？ Không cần 是: 今天星期三.",
    "level": "HSK1",
    "topics": [
      "time"
    ]
  },
  {
    "id": "zh-hant:slang:016bd4eecd22b153",
    "lang": "zh-hant",
    "kind": "slang",
    "text": "早！",
    "meaningVi": "Chào buổi sáng! (nói gọn)",
    "explanationVi": "Gặp người quen buổi sáng chỉ cần nói 早！ thay vì 早上好. Không dùng sau buổi trưa.",
    "register": "casual",
    "status": "current",
    "level": "HSK1",
    "topics": [
      "time"
    ]
  },
